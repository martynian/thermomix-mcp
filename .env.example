# Konto Cookidoo (to samo, ktorym logujesz sie w aplikacji / na cookidoo.pl)
COOKIDOO_EMAIL=twoj@email.pl
COOKIDOO_PASSWORD=haslo

# Lokalizacja — domyslnie Polska
COOKIDOO_COUNTRY=pl
COOKIDOO_LANGUAGE=pl-PL
COOKIDOO_URL=https://cookidoo.pl/foundation/pl-PL

# Domyslny model urzadzenia dla wyszukiwania i wlasnych przepisow
THERMOMIX_MODEL=TM6

# Gdzie trzymac token i dane pushy (domyslnie ~/.thermomix-mcp)
# THERMOMIX_MCP_STATE=C:\Users\<user>\.thermomix-mcp
